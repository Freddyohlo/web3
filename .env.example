# Copia este archivo a .env.local y completa los valores.
# El .env.local no se sube al repositorio (ya está en .gitignore).

# Project ID de WalletConnect Cloud (https://cloud.reown.com)
# Sin esto, el botón de conexión no abre el modal de wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# API key de Alchemy (https://dashboard.alchemy.com)
# Opcional: si no se define, se usa el RPC público de cada red.
NEXT_PUBLIC_ALCHEMY_API_KEY=
